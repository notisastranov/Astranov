{
  "id": "/",
  "name": "Astranov SpaceNet",
  "short_name": "SpaceNet",
  "description": "Astranov SpaceNet — Earth is the desktop. Install as a normal app, outside browser chrome.",
  "start_url": "/boot?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#02040a",
  "theme_color": "#02040a",
  "categories": ["navigation", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "GPS", "short_name": "GPS", "url": "/boot?gps=1", "description": "Land on your city" }
  ],
  "prefer_related_applications": false
}
